# CognoDB Cloud connection — Bolt 5.0-5.4
# Provision a free instance at https://console.cognodb.com/signup, then copy
# its connection URI here. CognoDB is a single instance, not a cluster, so
# use the direct encrypted scheme (bolt+s://) rather than the routing scheme
# (neo4j+s://) — the latter can fail routing-table discovery against it.
NEO4J_URI=bolt+s://<instance-id>.databases.cognodb.cloud:7687
NEO4J_USER=cognodb
NEO4J_PASSWORD=<your-cognodb-password>
NEO4J_DATABASE=neo4j
